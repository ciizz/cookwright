#!/bin/sh
# Managed by cookwright (npx cookwright init). The logic is in the package; this file only calls it.
command -v node >/dev/null 2>&1 || { echo "cookwright pre-push skipped, needs node, run setup"; exit 0; }
[ -f node_modules/cookwright/bin/cookwright.mjs ] || { echo "cookwright pre-push skipped: package not installed (npm install)"; exit 0; }
node node_modules/cookwright/bin/cookwright.mjs hook pre-push "$@"; s=$?
[ $s -eq 0 ] && exit 0
[ $s -eq 10 ] && exit 1
echo "cookwright pre-push crashed (exit $s); the push goes through unchecked"; exit 0
