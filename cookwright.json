{
  "$schema": "./packages/cookwright/schema/cookwright.schema.json",
  "version": 1,
  "level": 0,
  "hosts": ["claude"],
  "baseBranch": "main",
  "paths": {
    "bundles": "docs/dev/bundles",
    "closeouts": "docs/dev/closeouts",
    "backlog": "docs/dev/backlog.md",
    "playbook": "docs/playbook.md"
  },
  "gate": {
    "checks": [{ "name": "test", "run": "npm test" }]
  },
  "hooks": {
    "docSync": [
      {
        "name": "playbook",
        "code": [
          "packages/cookwright/src/bundle.mjs",
          "packages/cookwright/src/lib/bundle/*",
          ":!*.test.mjs",
          "hosts/claude/workflows/bundle-phase.js"
        ],
        "docs": ["docs/playbook.md", "hosts/claude/skills/bundle/SKILL.md"]
      }
    ]
  }
}
