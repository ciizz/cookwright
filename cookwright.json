{
  "$schema": "./packages/cookwright/schema/cookwright.schema.json",
  "version": 3,
  "level": 0,
  "hosts": [
    "claude"
  ],
  "packs": [],
  "baseBranch": "main",
  "ci": {
    "workflow": "ci.yml"
  },
  "paths": {
    "bundles": "docs/dev/bundles",
    "closeouts": "docs/dev/closeouts",
    "backlog": "docs/dev/backlog.md"
  },
  "gate": {
    "checks": [
      {
        "name": "test",
        "run": "npm test"
      }
    ]
  },
  "hooks": {
    "docSync": [
      {
        "name": "playbook",
        "code": [
          "packages/cookwright/src/bundle.mjs",
          "packages/cookwright/src/lib/bundle/*",
          ":!*.test.mjs",
          "packages/cookwright/hosts/claude/workflows/bundle-phase.js"
        ],
        "docs": [
          "packages/cookwright/docs/playbook.md",
          "packages/cookwright/skills/bundle/SKILL.md"
        ]
      },
      {
        "name": "setup",
        "code": [
          "packages/cookwright/skills/setup/SKILL.md",
          "packages/cookwright/src/lib/rules/agents-block.md",
          "packages/cookwright/packs/**",
          "packages/cookwright/src/lib/packs/*",
          ":!*.test.mjs"
        ],
        "docs": [
          "docs/guides/*.md"
        ]
      },
      {
        "name": "audit",
        "code": [
          "packages/cookwright/src/audit.mjs",
          "packages/cookwright/src/packs.mjs",
          "packages/cookwright/src/lib/command.mjs",
          "packages/cookwright/skills/docs-audit/SKILL.md"
        ],
        "docs": [
          "docs/guides/standards.md"
        ]
      },
      {
        "name": "standards",
        "code": [
          "packages/cookwright/src/standards.mjs",
          "packages/cookwright/src/lib/hooks/standards.mjs",
          "packages/cookwright/src/lib/doctor/packs.mjs",
          "packages/cookwright/src/lib/init/packs.mjs"
        ],
        "docs": [
          "docs/guides/standards.md"
        ]
      }
    ]
  }
}
